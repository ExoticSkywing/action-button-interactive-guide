{
  "name": "action-button-interactive-guide",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "check": "npm run lint && npm run build",
    "qa": "tsx scripts/qa.ts",
    "qa:stress": "tsx scripts/rail-stress-qa.ts",
    "qa:metal": "python3 scripts/verify-metal-loop.py",
    "qa:all": "npm run qa && npm run qa:stress && npm run qa:metal"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "globals": "^16.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.3.6"
  }
}
